{
  "name": "devlog-workspace",
  "private": true,
  "version": "0.6.0",
  "description": "Local-first product development logbook — desktop app, CLI and MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReCreatedOS/devlog-app.git"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @devlog/desktop dev",
    "build": "pnpm --filter @devlog/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @devlog/core test",
    "build:tools": "pnpm --filter @devlog/cli build && pnpm --filter @devlog/mcp build",
    "setup:claude": "node scripts/setup-claude-code.mjs",
    "dist:mac": "pnpm --filter @devlog/desktop dist:mac",
    "dist:win": "pnpm --filter @devlog/desktop dist:win"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
